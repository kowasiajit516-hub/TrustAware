# Base URL of the FastAPI backend (Phases 1-7). No trailing slash, nothing after the port.
#
# MODE A - phone on the same Wi-Fi, plain http (email/password login only):
#   VITE_API_BASE_URL=http://192.168.0.107:8000
#   (use the PC's LAN IP - NOT localhost; on a phone "localhost" is the phone itself.
#    Start the backend with: uvicorn main:app --host 0.0.0.0 --port 8000
#    and allow this page's origin in the backend CORS setting.)
#
# MODE B - Google Sign-In on a phone through an https tunnel (recommended):
#   VITE_API_BASE_URL=/api
#   "/api" is forwarded by the Vite dev server to the backend (see vite.config.js),
#   so the app and API share one https origin: no CORS and no mixed-content
#   blocking. It also works on the plain LAN address, so you can leave it set.
#   Backend location for the proxy (only if not http://127.0.0.1:8000):
#   BACKEND_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_BASE_URL=/api

# Google Sign-In (optional - leave blank to hide the button).
# OAuth 2.0 Client ID (type: Web application) from
# https://console.cloud.google.com/apis/credentials
# Must equal GOOGLE_CLIENT_ID in the backend .env.
# Google only accepts https:// origins (or http://localhost) under
# "Authorized JavaScript origins" - never a raw IP such as http://192.168.x.x.
VITE_GOOGLE_CLIENT_ID=300481962254-gc5kl6ektv6o3i8ggg7rumanpbauv6s4.apps.googleusercontent.com
