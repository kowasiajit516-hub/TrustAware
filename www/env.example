# Base URL of the FastAPI backend (Phases 1-7). No trailing slash.
VITE_API_BASE_URL=http://localhost:8000

# Google Sign-In (optional - leave blank to disable).
# Get this from https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID -> Application type: Web application).
# Must be the SAME client ID you put in backend/.env's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=300481962254-gc5kl6ektv6o3i8ggg7rumanpbauv6s4.apps.googleusercontent.com

